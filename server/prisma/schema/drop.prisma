model Drop {
  id             String         @id @default(uuid())
  title          String
  description    String?
  totalStock     Int
  availableStock Int
  startsAt       DateTime
  endsAt         DateTime?
  status         DropStatus     @default(SCHEDULED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reservations   Reservation[]
  purchases      Purchase[]

  @@map("drops")
}