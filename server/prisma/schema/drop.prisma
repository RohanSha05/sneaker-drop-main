model Drop {
  id             String        @id @default(uuid())
  title          String
  totalStock     Int
  availableStock Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  description    String?
  endsAt         DateTime?
  startsAt       DateTime?
  status         DropStatus    @default(SCHEDULED)
  purchases      Purchase[]
  reservations   Reservation[]

  @@index([status, startsAt])
  @@map("drops")
}
